# Keep Linux line endings for files that run inside Docker/Linux, even on Windows checkouts.
* text=auto
*.sh          text eol=lf
*.cql         text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Caddyfile*    text eol=lf
*.conf        text eol=lf
*.rs          text eol=lf
*.toml        text eol=lf
*.bat         text eol=crlf

*.png   binary
*.jpg   binary
*.ttf   binary
*.docx  binary
*.jar   binary
