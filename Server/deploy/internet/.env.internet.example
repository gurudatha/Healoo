# Copy to deploy/internet/.env — never commit the real file.
# DNS A/AAAA records for both names must point at this server before first start.
API_DOMAIN=api.example.com
FILES_DOMAIN=files.example.com
ACME_EMAIL=you@example.com

# Auth0 (design doc 5.1)
AUTH0_DOMAIN=careconnect-dev.us.auth0.com
AUTH0_AUDIENCE=https://api.careconnect.local
CLAIMS_NAMESPACE=https://careconnect.local/

# Object storage (SeaweedFS S3 gateway). Use long random values made of letters and digits only
# (no quotes, backslashes or spaces: they are written into a JSON file as they are).
S3_ACCESS_KEY=healooStorageKey
S3_SECRET_KEY=replaceWithALongRandomValue
