# Copy to deploy/lan/.env
# This computer's address on the Wi-Fi/LAN (e.g. from `ipconfig` / `ip addr`). Phones use it.
HOST_LAN_IP=192.168.1.20

# Offline trial: tokens signed locally (POST /dev/token). Set to auth0 to use your Auth0 tenant.
AUTH_MODE=dev
DEV_JWT_SECRET=change-me-to-something-long
FILES_SECRET=change-me-too

# Only needed when AUTH_MODE=auth0
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.careconnect.local
